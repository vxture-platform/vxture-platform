# Work runtime configuration. Supply a dedicated Work OIDC RP; never Console's RP.
# @package @vxture/workbench
# @layer Presentation
# @category config
# @author AI-Generated
# @date 2026-11-05

# Same-origin reverse proxy destinations, with no embedded credentials.
WORKBENCH_BFF_PROXY_URL=
WORKBENCH_CATALOG_PROXY_URL=
# Set these to 1 only when an external ingress serves the corresponding routes.
WORKBENCH_SAME_ORIGIN_BFF=0
WORKBENCH_SAME_ORIGIN_CATALOG=0
WORKBENCH_WEBSITE_URL=https://vxture.com
WORKBENCH_CONSOLE_URL=https://console.vxture.com
# Optional absolute JSON config path, read on each HTML request.
WORKBENCH_HOME_COPY_FILE=
