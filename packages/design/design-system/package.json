{
  "name": "@vxture/design-system",
  "version": "6.3.1",
  "description": "Vxture platform — design tokens, UI components, theme, icons",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs"
    },
    "./styles/brand.css": "./src/styles/brand.css",
    "./styles/brands/vxture.css": "./src/styles/brands/vxture.css",
    "./styles/fonts.css": "./src/styles/fonts.css",
    "./styles/globals.css": "./src/styles/globals.css",
    "./styles/workbench.css": "./src/styles/workbench.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.mjs",
      "require": "./dist/tokens.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.cjs"
    }
  },
  "files": [
    "dist",
    "docs",
    "src/styles",
    "assets",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "rimraf dist && node scripts/generate-reexports.mjs && tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/funnel-display": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@vxture/design-tokens": "workspace:*",
    "@vxture/design-ui": "workspace:*"
  },
  "peerDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.2.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@phosphor-icons/react": "^2.1.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
