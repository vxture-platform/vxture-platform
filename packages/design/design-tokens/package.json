{
  "name": "@vxture/design-tokens",
  "version": "2.0.0",
  "description": "Vxture 设计系统的 token 层：T1 原子（Tailwind v4 theme 镜像）与 T2 语义。",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/tailwind.css": "./src/styles/tailwind.css"
  },
  "files": [
    "dist",
    "src/styles",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vxture/vxture-platform.git",
    "directory": "packages/design/design-tokens"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "tailwindcss-animate": "^1.0.7"
  }
}
