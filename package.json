{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "vxture",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "description": "Vxture 大模型和智能体服务平台",
  "keywords": [
    "monorepo",
    "nextjs",
    "fastapi",
    "saas"
  ],
  "author": "vxture team",
  "scripts": {
    "// === 代码质量 ===": "",
    "// === 依赖管理 ===": "",
    "// === 开发环境 ===": "",
    "// === 数据库操作 ===": "",
    "// === 构建和部署 ===": "",
    "// === 测试 ===": "",
    "// === 环境检查 ===": "",
    "// === 部署相关 ===": "",
    "audit:env": "node scripts/guardrails/audit-env.mjs",
    "build": "pnpm --filter @vxture/website build",
    "build:all": "pnpm --filter @vxture-platform/shared build && pnpm --filter @vxture/core-* build && pnpm --filter @vxture/platform-* build",
    "build:backend-deps": "pnpm run --if-present --filter @vxture-platform/shared build && pnpm run --if-present --filter @vxture/core-* build",
    "build:core": "pnpm --filter @vxture/core-* build",
    "build:frontend-deps": "pnpm run --if-present --filter @vxture-platform/shared build && pnpm run --if-present --filter @vxture/core-* build && pnpm run --if-present --filter @vxture/platform-* build",
    "build:gateway": "pnpm --filter @vxture/bff-website build",
    "build:platform": "pnpm --filter @vxture/platform-* build",
    "build:shared": "pnpm --filter @vxture-platform/shared build",
    "check-deps": "pnpm audit && pnpm --recursive outdated",
    "check-env": "node -e \"console.log('Node:', process.version); console.log('PNPM:', process.env.npm_config_user_agent)\"",
    "clean": "pnpm --recursive clean && rimraf node_modules",
    "clean:cache": "pnpm store prune && rimraf .turbo .next dist build",
    "db:local:all": "node scripts/dev/db-local.mjs all",
    "db:local:ddl": "node scripts/dev/db-local.mjs ddl",
    "db:local:down": "node scripts/dev/db-local.mjs down",
    "db:local:reset": "node scripts/dev/db-local.mjs ddl --reset",
    "db:local:sample-user": "node scripts/dev/db-local.mjs sample-user",
    "db:local:secrets": "node scripts/dev/db-local.mjs secrets",
    "db:local:seed": "node scripts/dev/db-local.mjs seed",
    "db:local:signing-key": "node scripts/dev/db-local.mjs signing-key",
    "db:local:status": "node scripts/dev/db-local.mjs status",
    "db:local:up": "node scripts/dev/db-local.mjs up",
    "db:local:verify": "node scripts/dev/db-local.mjs verify",
    "db:migrate": "pnpm --filter @vxture/bff-website db:migrate",
    "db:reset": "pnpm --filter @vxture/bff-website db:reset",
    "db:seed": "pnpm --filter @vxture/bff-website db:seed",
    "db:seed:bulk": "node deploy/database/seed/seed-bulk.mjs",
    "db:seed:bulk-core": "node deploy/database/seed/seed-bulk-core.mjs",
    "db:seed:demo": "node deploy/database/seed/seed-demo.mjs",
    "dev": "pnpm --filter @vxture/website dev",
    "dev:admin": "pnpm --filter @vxture/admin dev",
    "dev:admin-bff": "pnpm --filter @vxture/bff-admin dev",
    "dev:auth-bff": "pnpm --filter @vxture/bff-auth dev",
    "dev:console": "pnpm --filter @vxture/console dev",
    "dev:console-bff": "pnpm --filter @vxture/bff-console dev",
    "dev:gateway": "pnpm --filter @vxture/bff-gateway dev",
    "dev:panel": "pnpm --filter @vxture/dev-panel dev",
    "dev:website-bff": "pnpm --filter @vxture/bff-website dev",
    "fixtures:inject": "node scripts/dev/fixtures.mjs inject",
    "fixtures:purge": "node scripts/dev/fixtures.mjs purge",
    "fixtures:status": "node scripts/dev/fixtures.mjs status",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,md}\"",
    "health": "pnpm check-env && pnpm type-check && pnpm lint && pnpm lint:design",
    "lint": "pnpm --recursive --if-present lint",
    "lint:account-rules": "node scripts/guardrails/check-account-rules.mjs",
    "lint:action-pinning": "node scripts/guardrails/check-action-pinning.mjs",
    "lint:anchor-writes": "node scripts/guardrails/check-anchor-writes.mjs",
    "lint:api-conventions": "node scripts/guardrails/check-api-conventions.mjs",
    "lint:audit-actions": "node scripts/guardrails/check-audit-actions.mjs",
    "lint:boundaries": "depcruise portals business bff services packages/core packages/shared packages/platform --config .depcruiserc.cjs",
    "lint:brand-name": "node scripts/guardrails/check-brand-name.mjs",
    "lint:catalog-domains": "node scripts/guardrails/check-catalog-domains.mjs",
    "lint:column-locks": "node scripts/guardrails/check-column-locks.mjs",
    "lint:conformance": "node scripts/guardrails/check-conformance-matrix.mjs",
    "lint:css-traps": "node scripts/guardrails/check-css-traps.mjs",
    "lint:data-design": "node scripts/guardrails/check-data-architecture.mjs",
    "lint:datetime-discipline": "node scripts/guardrails/check-datetime-discipline.mjs",
    "lint:design": "node scripts/guardrails/check-design-system.mjs",
    "lint:destructive": "node scripts/guardrails/check-destructive-confirmations.mjs",
    "lint:docs-numbering": "node scripts/guardrails/check-docs-numbering.mjs --strict",
    "lint:fix": "pnpm --recursive --if-present lint:fix",
    "lint:i18n-coverage": "node scripts/guardrails/check-i18n-coverage.mjs",
    "lint:literal-markdown": "node scripts/guardrails/check-literal-markdown.mjs",
    "lint:i18n-keys": "node scripts/guardrails/check-i18n-keys.mjs",
    "lint:message-usage": "node scripts/guardrails/check-message-usage.mjs",
    "lint:messages": "node scripts/guardrails/check-message-catalogs.mjs",
    "lint:migration-counts": "node scripts/guardrails/check-migration-absolute-counts.mjs",
    "lint:ops-todo-alerts": "node scripts/guardrails/check-ops-todo-alerts.mjs",
    "lint:permission-catalog": "node scripts/guardrails/check-tenant-permission-catalog.mjs",
    "lint:public-hygiene": "node scripts/guardrails/check-public-repo-hygiene.mjs",
    "lint:route-policies": "node scripts/guardrails/check-bff-route-policies.mjs",
    "lint:schema-residue": "node scripts/guardrails/check-schema-residue.mjs",
    "lint:section-indent": "node scripts/guardrails/check-section-body-indent.mjs",
    "lint:seed": "node scripts/guardrails/check-seed-idempotency.mjs",
    "lint:seed-constraints": "node scripts/guardrails/check-seed-check-constraints.mjs",
    "precommit": "pnpm lint:fix && pnpm type-check",
    "prepare": "husky || true",
    "prepush": "pnpm health && pnpm test",
    "preview": "pnpm --filter @vxture/website preview",
    "reset": "pnpm clean && pnpm clean:cache && pnpm install",
    "start": "pnpm dev",
    "start:console-bff": "pnpm --filter @vxture/bff-console start",
    "start:gateway": "pnpm --filter @vxture/bff-gateway start",
    "start:panel": "pnpm --filter @vxture/dev-panel start",
    "test": "pnpm --recursive test",
    "test:coverage": "pnpm --recursive test:coverage",
    "test:deploy-scripts": "bash deploy/scripts/lib/prune-images.test.sh",
    "test:watch": "pnpm --recursive test:watch",
    "type-check": "pnpm --filter @vxture/website type-check",
    "type-check:admin": "pnpm --filter @vxture/admin type-check",
    "type-check:admin-bff": "pnpm --filter @vxture/bff-admin type-check",
    "type-check:all": "pnpm --recursive type-check",
    "type-check:console": "pnpm --filter @vxture/console type-check",
    "type-check:console-bff": "pnpm --filter @vxture/bff-console type-check",
    "update": "pnpm --recursive update",
    "lint:oidc-discovery": "node scripts/guardrails/check-oidc-discovery.mjs",
    "lint:public-routes": "node scripts/guardrails/check-public-routes.mjs"
  },
  "devDependencies": {
    "@swc/core": "^1.15.18",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^9.39.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "postcss": "^8.5.23",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --flag unstable_config_lookup_from_file --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "body-parser@1": "^1.20.6",
      "body-parser@2": "^2.3.0",
      "shell-quote": "^1.8.4",
      "postcss": "^8.5.23",
      "vite": "7.3.6",
      "@babel/plugin-transform-modules-systemjs": "^7.29.4",
      "@humanfs/node": "^0.16.8",
      "brace-expansion@1": "^1.1.13",
      "browserslist": "^4.28.7",
      "esbuild": "^0.28.1",
      "brace-expansion@5": "^5.0.9",
      "fast-uri": "^3.1.6",
      "file-type": "^21.3.2",
      "flatted": "^3.4.2",
      "js-yaml@4": "^4.3.2",
      "nanoid@3": "^3.3.18",
      "lodash": "^4.18.0",
      "multer": "^2.3.0",
      "path-to-regexp@0": "^0.1.13",
      "path-to-regexp@8": "^8.4.0",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "qs": "^6.16.0",
      "sharp": "^0.35.4",
      "websocket-driver": "^0.7.5",
      "yaml@2": "^2.8.3"
    }
  }
}
