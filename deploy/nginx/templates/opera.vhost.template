# opera.vhost.template — 能力控制台公网 vhost（product_250 M-4 批C）
#
# 加固决策（2026-07-28 批A 拍板,均为硬性项）：
#  1. 真实域名不入仓：本文件是模板,${VX_OPERA_HOST} 由
#     20-sync-nginx-config.sh 从主机 /srv/vxture/runtime/.env.opera-bff
#     的 OPERA_BASE_URL 渲染;仓内文档一律以 x.vxture.com 指代。
#  2. 通配符证书（*.vxture.com 既有）：单签证书会经 CT 日志即时公开主机名。
#  3. SSO 前置零内容：除 /auth/*（登录/回调必须匿名可达）外,一切路径过
#     auth_request 门（opera-bff /auth/check）;未认证 → 302 /auth/login,
#     不回显任何页面/静态资源内容。
#  4. default_server 兜底见 00-default.conf;限流继承 conf.d/00-hardening.conf。
#
# 模块挂载（联邦一档 = 路径挂载,10-shell-mount-contract.md）：
#  /atlas/* → atlas admin-module（worker-02,批D 启用）;/runos/* → runos 模块(批F)。
#  auth_request 门对模块路径额外铸 operator-OBO 管理票(M-1),经
#  X-Operator-Token 注入上游 Authorization,模块永远见操作者本人身份。

server {
    listen 80;
    listen [::]:80;
    server_name ${VX_OPERA_HOST};
    return 301 https://${VX_OPERA_HOST}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${VX_OPERA_HOST};

    ssl_certificate     /etc/nginx/ssl/live/vxture.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/vxture.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Frame-Options           SAMEORIGIN always;
    add_header X-Content-Type-Options    nosniff always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    # OSS 面不需要被索引;纵深防御(未认证本就零内容)。
    add_header X-Robots-Tag              "noindex, nofollow" always;

    resolver 127.0.0.11 valid=10s ipv6=off;

    # ── auth_request 门（内部子请求,opera-bff 校验 RP 会话）──
    location = /__vx_auth {
        internal;
        set $operabff vx-platform-opera-bff:3041;
        proxy_pass              http://$operabff/auth/check;
        proxy_pass_request_body off;
        proxy_set_header        Content-Length "";
        proxy_set_header        X-Original-URI $request_uri;
        proxy_set_header        Host $host;
    }

    # 未认证：302 到 RP 登录（workforce SSO）,零内容回显。
    error_page 401 = @vx_login;
    location @vx_login {
        return 302 /auth/login?returnTo=$scheme://$host$request_uri;
    }

    # ── RP 登录/回调/登出 —— 唯一匿名可达面 ──
    location /auth/ {
        set $operabff vx-platform-opera-bff:3041;
        proxy_pass         http://$operabff;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location /_next/static/ {
        auth_request /__vx_auth;
        set $upstream vx-platform-opera:3040;
        proxy_pass         http://$upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_buffering    on;
        add_header         Cache-Control "public, max-age=31536000, immutable";
    }

    # ── 数据面 /api/* → opera-bff ────────────────────────────────────────────
    # 没有这一块时,/api/* 落进下方 `location /` 打到 Next 门户容器,而门户的
    # next.config rewrite 是 **dev-only seam**(目标 localhost:3041,生产容器里
    # 没有 BFF)——于是生产上所有数据请求 500,auth 却正常(/auth/ 直达 BFF),
    # 表现为「登录好好的,页面全在报 Request failed (500)」。admin vhost 从一开始
    # 就有同款 /api/ 块;opera 的漏了。同过 auth_request 门(零内容裸奔原则)。
    #
    # /api/health 是 Next 门户自身的路由(app/api/health,容器健康检查用),
    # 精确避让到前端——与 next.config rewrite 的排除是同一条。
    location = /api/health {
        auth_request /__vx_auth;
        set $upstream vx-platform-opera:3040;
        proxy_pass         http://$upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location /api/ {
        auth_request /__vx_auth;
        set $operabff vx-platform-opera-bff:3041;
        proxy_pass         http://$operabff;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # ── 模块挂载位（批D 启用 atlas;批F 启用 runos）──────────────────────────
    # 启用时取消注释并填 worker-02 tailnet 地址;auth_request 门铸 aud=atlas 的
    # operator-OBO 票,经 X-Operator-Token 注入 Authorization(M-1)。
    #location /atlas/ {
    #    auth_request /__vx_auth;
    #    auth_request_set $vx_op_token $upstream_http_x_operator_token;
    #    proxy_pass         http://<worker-02-tailnet-ip>:<atlas-admin-module-port>;
    #    proxy_http_version 1.1;
    #    proxy_set_header   Host              $host;
    #    proxy_set_header   X-Forwarded-Proto $scheme;
    #    proxy_set_header   Authorization     "Bearer $vx_op_token";
    #}

    location / {
        auth_request /__vx_auth;
        set $upstream vx-platform-opera:3040;
        proxy_pass         http://$upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        '';
    }
}
