# admin.vhost.template — 运营后台公网 vhost（vx-platform-admin:3040）
#
# 真实域名不入仓（2026-07-28 加固决策追加,与能力控制台/opera 同一性质,见
# product_250 M-4 附注）：本文件是模板,${VX_ADMIN_HOST} 由
# 20-sync-nginx-config.sh 从主机 /srv/vxture/runtime/.env.admin-bff 的
# ADMIN_BASE_URL 渲染;仓内文档一律以 y.vxture.com 指代(与 opera 的
# x.vxture.com 区分,避免暗示同一主机)。admin 是既有长期生产服务,渲染为
# 必选步骤——env 缺失时同步脚本报错退出,不静默跳过。
#
# /varda/* 经 Tailscale 直连 vx-worker-02 varda-bff（${VX_WORKER02_TAILNET_IP}:3090，原3121，2026-07-24 L0端口迁移）

server {
    listen 80;
    listen [::]:80;
    server_name ${VX_ADMIN_HOST};
    return 301 https://${VX_ADMIN_HOST}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${VX_ADMIN_HOST};

    ssl_certificate     /etc/nginx/ssl/live/vxture.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/vxture.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Frame-Options           SAMEORIGIN always;
    add_header X-Content-Type-Options    nosniff always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    # Varda SSE — 直连 Tailscale IP，无需 resolver
    location /varda/ {
        proxy_pass         http://${VX_WORKER02_TAILNET_IP}:3090;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        '';
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 300s;
    }

    resolver 127.0.0.11 valid=10s ipv6=off;

    location /_next/static/ {
        set $upstream vx-platform-admin:3040;
        proxy_pass         http://$upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_buffering    on;
        add_header         Cache-Control "public, max-age=31536000, immutable";
    }

    # ── OIDC RP（/auth/*）+ admin-bff 数据 API（/api/*）→ 同源到 admin-bff ──
    # admin 是 operator-realm 的 OIDC RP；/auth/login + /auth/callback 必须到
    # admin-bff，否则 IdP 回调落到前端导致登录死循环。vx_rp_session cookie 与
    # portal 同源（identity-access-topology.md §4）。/api/health 是 portal 自身
    # 容器健康检查路由，精确避让到前端。
    location = /api/health {
        set $upstream vx-platform-admin:3040;
        proxy_pass         http://$upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location /auth/ {
        set $adminbff vx-platform-admin-bff:3031;
        proxy_pass         http://$adminbff;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location /api/ {
        set $adminbff vx-platform-admin-bff:3031;
        proxy_pass         http://$adminbff;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location / {
        set $upstream vx-platform-admin:3040;
        proxy_pass         http://$upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        '';
    }
}
