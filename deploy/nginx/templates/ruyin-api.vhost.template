# Controlled client ingress; only the current desktop adapter endpoints are public.
# @package @vxture/repo
# @layer Infrastructure
# @category deployment
# @author AI-Generated
# @date 2026-11-22
limit_req_zone $binary_remote_addr zone=ruyin_auth:1m rate=5r/s;

server {
    listen 80;
    listen [::]:80;
    server_name app.ruyin.work;
    return 308 https://app.ruyin.work$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name app.ruyin.work;
    # Reject a mismatched HTTP Host even if TLS SNI selected this server.
    if ($host != app.ruyin.work) { return 404; }
    ssl_certificate     /etc/nginx/ssl/live/vxture.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/vxture.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy "no-referrer" always;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $ruyin_api vx-platform-workbench-bff:3061;
    client_max_body_size 16k;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection '';
    proxy_set_header Cookie '';
    proxy_cache off;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;

    location = /healthz {
        if ($request_method != GET) { return 405; }
        proxy_pass http://$ruyin_api/desktop$uri$is_args$args;
    }
    location ~ ^/auth/(login|callback|native/done)$ {
        if ($request_method != GET) { return 405; }
        limit_req zone=ruyin_auth burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://$ruyin_api/desktop$uri$is_args$args;
    }
    location ~ ^/auth/(native/(claim|logout)|backchannel-logout)$ {
        if ($request_method != POST) { return 405; }
        limit_req zone=ruyin_auth burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://$ruyin_api/desktop$uri$is_args$args;
    }
    location ~ ^/api/(me(/(workspaces|organization))?|tenant-context|iam/workspaces/mine|subscription/(subscribed-products|quota-usage))$ {
        if ($request_method != GET) { return 405; }
        proxy_pass http://$ruyin_api/desktop$uri$is_args$args;
    }
    location ~ "^/api/applications/[a-z][a-z0-9_-]{0,63}/icon$" {
        if ($request_method != GET) { return 405; }
        proxy_pass http://$ruyin_api/desktop$uri$is_args$args;
    }
    location / { return 404; }
}
