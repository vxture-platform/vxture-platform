# deploy/.env.capconsole-bff
# Runtime env for capconsole-bff — the Capability Console shell BFF
# (product_250 M-4 batch C). Second workforce-realm OIDC RP (client_id
# "capconsole"); also runs the operator-OBO exchange (M-1) that the nginx
# auth_request gate injects into provider admin-module requests.
#
# Shared platform secrets (REDIS_URL, …) are injected by compose.platform.yml
# through secrets/platform.env. Do not duplicate them here.
#
# HARDENING (batch-A decision, 2026-07-28): the console's real public hostname
# must NEVER enter the repo. This example uses the x.vxture.com placeholder;
# the production file on the host carries the real vhost.

NODE_ENV=production
CAPCONSOLE_BFF_PORT=3051

# Internal service URLs
AUTH_BFF_URL=http://vx-platform-auth-bff:3061

# OIDC issuer = public IdP face (accounts surface).
OIDC_ISSUER=https://accounts.vxture.com

# This RP's own public origin. redirect_uri = ${CAPCONSOLE_BASE_URL}/auth/callback
# must match the seeded appoidc.oidc_clients row — seed and this env must carry
# the SAME real hostname (both host-side only; repo keeps the placeholder).
CAPCONSOLE_BASE_URL=https://x.vxture.com

# Confidential RP client secret (client_id "capconsole"). Generated + filled by
# scripts/27-provision-client-secrets.sh; the matching bcrypt hash lands in
# .env.auth-bff (OIDC_CLIENT_SECRET_HASH_CAPCONSOLE) → seed → appoidc. Empty at
# runtime → RP token exchange fails 401 invalid_client.
OIDC_CLIENT_SECRET=

# Operator RP session TTL (seconds). Default 43200 (12h) — short on purpose for
# the high-privilege OSS surface.
#RP_SESSION_TTL=43200
