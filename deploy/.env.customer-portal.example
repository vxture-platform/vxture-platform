# Runtime settings for the dedicated customer portal stack.
# @package @vxture/repo
# @layer Infrastructure
# @category deployment
# @author AI-Generated
# @date 2026-11-15
# Copy to /srv/vxture/runtime/.env.customer-portal-bff with mode 0600.
# Pass it to compose with --env-file. Supply pinned image references on deploy.
CUSTOMER_PORTAL_FRONTEND_IMAGE=
CUSTOMER_PORTAL_BFF_IMAGE=
CUSTOMER_PORTAL_BFF_TOKEN=
CUSTOMER_PORTAL_DATABASE_URL=
CUSTOMER_PORTAL_REDIS_URL=
OIDC_ISSUER=https://accounts.vxture.com
OIDC_CLIENT_ID=customer-portal
OIDC_CLIENT_SECRET=
OIDC_BACKCHANNEL_ISSUER=

# Deployment control only; compose does not inject these keys into either service.
# Unquoted comma-separated exact hosts, no spaces. Empty keeps the edge disabled.
# Keep the first host published while it serves back-channel logout for this client.
CUSTOMER_PORTAL_HOSTS=
# Bcrypt hash generated from the portal's own client secret; used only by the OIDC seed.
OIDC_CLIENT_SECRET_HASH_CUSTOMER_PORTAL=
