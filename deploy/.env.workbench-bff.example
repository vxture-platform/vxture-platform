# Workbench customer-realm confidential RP. Generated runtime files are private.
# @package @vxture/repo
# @layer Infrastructure
# @category deployment
# @author AI-Generated
# @date 2026-11-05
NODE_ENV=production
WORKBENCH_BFF_PORT=3061
WORKBENCH_BASE_URL=https://ruyin.work
OIDC_ISSUER=https://accounts.vxture.com
OIDC_BACKCHANNEL_ISSUER=http://vx-platform-auth-bff:3081
OIDC_CLIENT_ID=workbench
# Provisioned by 27-provision-client-secrets.sh after client registration.
OIDC_CLIENT_SECRET=
RP_COOKIE_INSECURE=false
# Dedicated connections avoid sharing JWT, IdP or legacy internal credentials.
# Use a SELECT-only DB role against the primary; membership reads must be current.
DATABASE_URL=postgresql://reporting_ro:CHANGEME@pgm-CHANGEME.pg.rds.aliyuncs.com:5432/vxturestudio_platform_main
REPORTING_RO_DATABASE_URL=
# Dedicated role: SELECT(id, account_id, deleted_at, read_at), UPDATE(read_at) only.
# Provision the role and its private password before deploying inbox actions.
WORKBENCH_INBOX_DATABASE_URL=postgresql://svc_workbench_inbox:CHANGEME@pgm-CHANGEME.pg.rds.aliyuncs.com:5432/vxturestudio_platform_main
# Dedicated favorites, launch history and sort preference writer.
WORKBENCH_ACTIVITY_DATABASE_URL=postgresql://svc_workbench_activity:CHANGEME@pgm-CHANGEME.pg.rds.aliyuncs.com:5432/vxturestudio_platform_main
REDIS_URL=redis://:CHANGEME@r-CHANGEME.redis.rds.aliyuncs.com:6379
