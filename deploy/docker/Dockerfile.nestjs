# syntax=docker/dockerfile:1
# Dockerfile.nestjs — NestJS BFF 通用 Dockerfile（esbuild 单文件，无 Prisma）
# 构建参数：
#   SERVICE_PATH    服务相对路径，如 bff/auth-bff
#   PACKAGE_FILTER  pnpm 包名，如 @vxture/bff-auth
#
# 用法（从 repo 根目录执行）：
#   docker build -f deploy/docker/Dockerfile.nestjs \
#     --build-arg SERVICE_PATH=bff/auth-bff \
#     --build-arg PACKAGE_FILTER=@vxture/bff-auth \
#     -t ghcr.io/vxture/platform_bff-auth:latest .

ARG NODE_VERSION=24

# ── 构建层 ────────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION}-alpine AS builder
WORKDIR /repo

RUN corepack enable && corepack prepare pnpm@10.30.3 --activate

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY packages/ packages/
COPY services/ services/
COPY bff/ bff/
COPY portals/ portals/
COPY business/ business/
# tools/dev-panel is excluded from build context (dev-only) but pnpm needs it as workspace stub
RUN mkdir -p tools/dev-panel && echo '{"name":"@vxture/dev-panel","version":"0.0.0"}' > tools/dev-panel/package.json

# B7: pnpm store 走 BuildKit cache mount —— 源码改动触发 install 重跑时依赖从持久
# store 取（downloaded 0）。esbuild 单文件打包无标准编译缓存目录，故仅缓存依赖层。
# GitHub Packages 鉴权（拆仓前置）。仓根 .npmrc 把 @vxture scope 指向
# npm.pkg.github.com、token 从 NODE_AUTH_TOKEN 取；设计三包拆出去之后它们不再是
# workspace:* 而是从 registry 装，**GitHub Packages 即便包公开也要求鉴权**。
#
# token 走 BuildKit secret，**绝不能用 ARG**：ARG 的值会留在镜像层历史里，
# `docker history` 就能读出来——那等于把凭据发布到镜像仓库。secret 只在这一条
# RUN 的时间窗内挂载为文件，不进任何层。
#
# `|| true` 是刻意的：secret 未挂载时（例如本地不带 --secret 构建）读取会失败，
# 但那种情况下也不需要 token。真正缺 token 的场景会在紧接着的 install 里以
# 401/404 失败，而不是被这里静默吞掉。
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    --mount=type=secret,id=node_auth_token \
    NODE_AUTH_TOKEN="$(cat /run/secrets/node_auth_token 2>/dev/null || true)" \
    pnpm install --frozen-lockfile --store-dir /pnpm/store

ARG PACKAGE_FILTER
# 各 BFF 的 build 脚本内部会先调用 pnpm -w build:backend-deps，无需额外步骤
RUN pnpm --filter ${PACKAGE_FILTER} build

# ── 运行层（单文件，无 node_modules）────────────────────────────────────────
FROM node:${NODE_VERSION}-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

# Build provenance (standard 025) — runtime ENV read by the /healthz identity
# block. Honest defaults so builds never break when args aren't passed; CI
# injects real values from the git tag / sha / build time.
ARG APP_VERSION=dev
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ARG DEPLOY_STAGE=dev
ENV APP_VERSION=${APP_VERSION} \
    GIT_SHA=${GIT_SHA} \
    BUILD_TIME=${BUILD_TIME} \
    DEPLOY_STAGE=${DEPLOY_STAGE}

RUN apk add --no-cache curl \
  && addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nodeapp

ARG SERVICE_PATH
COPY --from=builder --chown=nodeapp:nodejs /repo/${SERVICE_PATH}/dist/main.cjs ./

USER nodeapp

CMD ["node", "main.cjs"]
