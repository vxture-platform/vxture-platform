# deploy/.env.console-bff
# Runtime env for console-bff. Auth requests are delegated to auth-bff.
#
# Shared platform secrets are injected by compose.platform.yml through
# secrets/platform.env. Shared mail credentials are injected through
# secrets/platform-mail.env. Do not duplicate DATABASE_URL, REDIS_URL,
# JWT_SECRET, JWT_REFRESH_SECRET, AUTH_INTERNAL_TOKEN, or SMTP_* here.

NODE_ENV=production
CONSOLE_BFF_PORT=3021
DB_POOL_MAX=10

# JWT runtime options
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d
AUTH_COOKIE_DOMAIN=.vxture.com

# Internal service URLs
AUTH_BFF_URL=http://vx-platform-auth-bff:3081
# 2026-07-29 更正：此前误指向 worker-01 本机已退役的旧 model-platform 容器名（同名
# orphan 容器仍在跑,碰巧能解析,实际打不到真实 atlas）。Atlas 现部署于 worker-02，
# varda 部署登记已随 vxture-varda 独立仓迁出(2026-08-18)。
# 值，见 docs/50-deployment/13-infra-allocation-registry.md §3 atlas 行）。
ATLAS_API_URL=http://<worker-02-tailnet-ip>:3100
# C2 entitlement resolution (product_220 §3) — TD-042 remediation: console-bff
# resolves workspace entitlements/quota through platform-api instead of
# re-deriving them from raw metering.quota_pools queries.
PLATFORM_API_URL=http://vx-platform-api:8080

# OIDC issuer = public IdP face (accounts surface). The RP builds the browser
# authorize redirect + discovery from this; MUST be the public issuer, not the
# localhost schema default. See docs/design/identity-access-topology.md.
OIDC_ISSUER=https://accounts.vxture.com

# This RP's own public origin. The RP derives its redirect_uri
# (${CONSOLE_BASE_URL}/auth/callback) + allowed return origins from it; MUST be
# the public host, not the localhost schema default — otherwise the IdP rejects
# authorize with 400 invalid_redirect_uri (the registered redirect_uris are
# https://console.vxture.com/auth/callback).
CONSOLE_BASE_URL=https://console.vxture.com

# Confidential RP client secret. The browser client_id is "console"; this secret
# authenticates the RP at the IdP token endpoint. Generated + filled by
# scripts/27-provision-client-secrets.sh; the matching bcrypt hash lands in
# .env.auth-bff (OIDC_CLIENT_SECRET_HASH_CONSOLE) → seed → iam.oidc_client. Empty
# here blocks deploy via strict env-audit; unfilled at runtime → RP token
# exchange fails 401 invalid_client.
OIDC_CLIENT_SECRET=

# ── Offline payment channels (product_321 §4.4) ─────────────────────────────
# Channel `enabled` is DERIVED: every env of a channel must be non-blank after
# trim, or the payment page ships the channel disabled (never enabled with
# empty credentials). Values below are the owner-provided placeholders
# (2026-07-18); replace with the real account when it changes — db-init
# sync-env only appends missing keys and never overwrites runtime values.
OFFLINE_PAY_ACCOUNT_NAME=如影工作室
OFFLINE_PAY_BANK_NAME=中国银行
OFFLINE_PAY_ACCOUNT_NO=000000000000000000000000
# Console-site asset path for the Alipay payment QR (served by the console
# portal; the BFF only passes the string through).
OFFLINE_PAY_ALIPAY_QR=/assets/payment/vx-alipay.png

# Payment window by tenant type (minutes, product_321 P4 rev. 2026-08-20).
# Fixed per order at creation and persisted (billing.orders.payment_ttl_minutes);
# the personal value doubles as the display/sweep fallback for legacy rows.
# ORDER_PAYMENT_TTL_MINUTES=30
# ORDER_PAYMENT_TTL_MINUTES_ORG=2880
