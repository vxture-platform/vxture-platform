# deploy/.env.platform-api
# Runtime env for platform-api — the product-facing S2S host (product_310 D13):
# C2 entitlements/visible-set reads, C3 consume/gauge writes, and the commerce
# background jobs (provisioning dispatch, sharing/trial expiry sweeps).
#
# Shared platform secrets are injected by compose.platform.yml through
# secrets/platform.env (+ platform-app.env for the platform_svc DB role).
# Do not duplicate DATABASE_URL, REDIS_URL, JWT_SECRET, JWT_REFRESH_SECRET,
# or AUTH_INTERNAL_TOKEN here.
#
# No OIDC RP identity: this host serves no browser traffic. It only VERIFIES
# IdP-minted S2S bearer tokens against the IdP JWKS (fetched from AUTH_BFF_URL
# over the internal network — the signing private key stays in auth-bff).

NODE_ENV=production
PLATFORM_API_PORT=8080
DB_POOL_MAX=10

# Internal IdP URL — JWKS back-channel for S2S bearer verification.
AUTH_BFF_URL=http://vx-platform-auth-bff:3081

# Expected `iss` of IdP-minted S2S tokens (public issuer face).
OIDC_ISSUER=https://accounts.vxture.com

# Arda provisioning webhook HMAC secret (product_310 P2.3, host moved here by
# D13). product.product_webhooks stores only this VAR NAME as
# webhook_secret_ref, resolved from the dispatcher's process env at delivery
# time to sign POST ${ARDA_BASE_URL}/provisioning/webhook
#   x-vxture-signature: t=<ts>,v1=hex(HMAC_SHA256(secret, "{t}.{raw_body}"))
# MUST equal PROVISION_WEBHOOK_SECRET on the arda host (owner transfers the
# value out-of-band; generate with `openssl rand -hex 32`). Optional until the
# arda webhook goes live — unset means deliveries retry to dead-letter.
ARDA_PROVISION_WEBHOOK_SECRET=

# Karda provisioning webhook HMAC secret (same scheme as ARDA above). Name
# reserved now per registration request A段 (secret issuance doesn't depend on
# the delivery address); the product.product_webhooks row itself (which needs
# KARDA_WEBHOOK_BASE_URL) is deferred to B段 until karda's host is assigned —
# see docs/80-liaison/20-2607222338-karda-platform-registration-a.md §5.
KARDA_PROVISION_WEBHOOK_SECRET=

# Vxtpl provisioning webhook HMAC secret (same scheme as ARDA/KARDA above).
# owner 2026-08-13 完全产品化后新增；owner 生成（`openssl rand -hex 32`）并带外
# 转运到 vxtpl 主机，两侧同值。未设 = 投递重试进死信，不阻断部署。
VXTPL_PROVISION_WEBHOOK_SECRET=

# Job cadences (ms) — defaults built in; override only when tuning.
# PROVISION_DISPATCH_INTERVAL_MS=10000
# SHARING_EXPIRY_SWEEP_INTERVAL_MS=60000
# TRIAL_EXPIRY_SWEEP_INTERVAL_MS=60000
# ORDER_PAYMENT_SWEEP_INTERVAL_MS=60000
# SUBSCRIPTION_RENEWAL_SWEEP_INTERVAL_MS=60000
# WS_BASE_POOL_SWEEP_INTERVAL_MS=60000
# USAGE_ROLLUP_INTERVAL_MS=300000

# Subscription renewal engine (product_330 P2-c). Auto-renew opens a system
# `renew` order LEAD days before end_at (¥0 plans settle and extend at once;
# paid plans wait for the customer to pay, order TTL = end_at + GRACE days).
# Subscriptions past end_at without a fulfilled renewal flip to `expired`;
# paying the renewal order afterwards revives them from that moment.
# SUBSCRIPTION_RENEW_LEAD_DAYS=7
# SUBSCRIPTION_RENEW_GRACE_DAYS=3

# Workspace base storage grant (bytes) — the `ws_base` pool every live
# workspace carries (product_220 §4.4 target model; owner 2026-08-20: default
# 200 MiB, policy-configurable, never hard-coded). Read per sweep tick: a
# change here reconciles every ACTIVE base pool on the next pass.
# WS_BASE_STORAGE_BYTES=209715200

# Payment window (minutes) for pending offline orders (product_321 P4).
# First sweep after rollout closes any legacy over-TTL pending orders as
# `order_expired` — owner ruling 2026-07-18: ship the default, no staging.
# P4 rev. 2026-08-20: each order persists its own TTL at creation
# (subscriptions.payment_ttl_minutes, personal 30 / organization 2880, set by
# console-bff); this value is only the fallback for legacy NULL rows.
# ORDER_PAYMENT_TTL_MINUTES=30
