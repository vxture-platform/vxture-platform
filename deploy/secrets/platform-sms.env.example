# deploy/secrets/platform-sms.env
# Outbound phone verification-code credentials — Aliyun Number Authentication
# Service (号码认证服务, PNVS / Dypnsapi). Do not commit real values.
#
# compose.platform.yml injects this file only into containers that send phone
# verification codes (auth-bff — the IdP phone-code sender — and console-bff,
# whose phone-change flows send/verify codes). Do not duplicate ALIYUN_SMS_*
# in .env.<service> files. When the four required values are unset,
# @vxture/service-sms falls back to console.log + a fixed dev code in
# NON-production only; in production it fails closed — send throws, every code
# rejected (2026-07-21). Set real values for production phone-code login.
#
# The RAM AccessKey must be granted Dypnsapi permission (e.g. AliyunDypnsFullAccess);
# create one under RAM 访问控制 → 用户 if none exists. SignName/TemplateCode are the
# preset public values from the Number Authentication Service console (短信验证码 /
# 个人开发者免资质) — not secret. Preset templates 100001–100005 each carry two
# variables ${code} and ${min}; @vxture/service-sms fills ##code## (Aliyun generates
# the code) and ${min} (= ALIYUN_SMS_VALID_SECONDS / 60).
#
# Templates control message text; SchemeName isolates provider verification codes.
# Each purpose below must use a distinct, explicitly configured Aliyun scheme.
# Customer phone-code login intentionally also registers unknown phones.

# Required (AccessKey is account-specific; sign/template are the shared presets)
ALIYUN_SMS_ACCESS_KEY_ID=CHANGEME
ALIYUN_SMS_ACCESS_KEY_SECRET=CHANGEME
ALIYUN_SMS_SIGN_NAME=速通互联验证码
ALIYUN_SMS_TEMPLATE_CODE=100001

# Required distinct SchemeName API values, each at most 20 characters.
# These names are supplied by the caller; no console scheme creation is required.
ALIYUN_SMS_SCHEME_NAME=legacy-customer
ALIYUN_SMS_CUSTOMER_LOGIN_SCHEME_NAME=customer-login
ALIYUN_SMS_CUSTOMER_REGISTER_SCHEME_NAME=customer-register
ALIYUN_SMS_CUSTOMER_SOCIAL_BIND_SCHEME_NAME=customer-social-bind
ALIYUN_SMS_WORKFORCE_LOGIN_SCHEME_NAME=workforce-login
ALIYUN_SMS_WORKFORCE_PHONE_CHANGE_SCHEME_NAME=wf-phone-change
# Optional (defaults: code length 6 to match the frontend, 300s validity)
# ALIYUN_SMS_CODE_LENGTH=6
# ALIYUN_SMS_VALID_SECONDS=300

# ── Business notification SMS (product_330 P2-i, 2026-09-04) ─────────────────
# Customer notifications (expiry reminder / renewal order / activation / refund
# progress / announcements) go through the SMS Service (短信服务, Dysmsapi SendSms),
# NOT the number-authentication presets above. Same AccessKey (grant
# AliyunDysmsFullAccess); a *notification* signature and one approved template per
# message are required. A notification is sent by SMS only when its template code
# below is set AND the user enabled the sms channel for that topic (default off).
# Template variables are truncated to 20 chars by the sender; amounts are digits only.
#
# Register these template texts (通知类) in the SMS console, then paste the SMS_ codes:
#   subscription.expiring_soon  您订阅的${product} ${plan}将于${date}到期（还有${days}天）。未开启自动续费，到期后服务停止，可在控制台续费。
#   subscription.expired        您订阅的${product} ${plan}已于${date}到期，服务已停止，可在控制台续费恢复。
#   subscription.renewed        您订阅的${product} ${plan}已续费，新周期至${date}，实付${amount}元。
#   order.fulfilled             您的订单${order}已开通${product} ${plan}，有效期至${date}，实付${amount}元。
#   order.renewal_created       已为您生成${product} ${plan}的续费订单${order}，应付${amount}元，请在${date}前完成付款。
#   refund.requested            订单${order}的退款申请已收到，金额${amount}元，我们会尽快审核。
#   refund.approved             订单${order}的退款${amount}元已审核通过，将按原渠道退回。
#   refund.rejected             订单${order}的退款申请未通过，原因：${reason}。
#   refund.completed            订单${order}的退款${amount}元已退回原付款渠道。
#   announcement.published      平台公告：${title}，详情请登录控制台查看。
# ALIYUN_SMS_NOTIFY_SIGN_NAME=          # notification signature (falls back to ALIYUN_SMS_SIGN_NAME)
# ALIYUN_SMS_TPL_SUBSCRIPTION_EXPIRING_SOON=SMS_
# ALIYUN_SMS_TPL_SUBSCRIPTION_EXPIRED=SMS_
# ALIYUN_SMS_TPL_SUBSCRIPTION_RENEWED=SMS_
# ALIYUN_SMS_TPL_ORDER_FULFILLED=SMS_
# ALIYUN_SMS_TPL_ORDER_RENEWAL_CREATED=SMS_
# ALIYUN_SMS_TPL_REFUND_REQUESTED=SMS_
# ALIYUN_SMS_TPL_REFUND_APPROVED=SMS_
# ALIYUN_SMS_TPL_REFUND_REJECTED=SMS_
# ALIYUN_SMS_TPL_REFUND_COMPLETED=SMS_
# ALIYUN_SMS_TPL_ANNOUNCEMENT_PUBLISHED=SMS_

# Isolated customer account-center security and new-phone verification schemes.
ALIYUN_SMS_CUSTOMER_SECURITY_SCHEME_NAME=customer-security
ALIYUN_SMS_CUSTOMER_PHONE_CHANGE_SCHEME_NAME=cust-phone-change
