# deploy/secrets/platform-idp-internal.env
# Shared secret for the IdP's INTERNAL face only. Do not commit real values.
#
# compose.platform.yml injects this file ONLY into the four containers that open
# or call auth-bff's /internal/* (operator / customer account admin, step-up):
#   auth-bff (receiver) · admin-bff · arche-bff · opera-bff (senders)
# website-bff, console-bff and platform-api must NOT receive it — they neither
# read nor send it, and the point of this file is that the product-face value
# (AUTH_INTERNAL_TOKEN in platform.env, handed to product teams) can no longer
# open the operator-management face.
#
# Generated on the deploy host by scripts/34-provision-idp-internal-secret.sh
# (openssl rand -hex 16 → 32 hex chars, 0600; asserts the value differs from
# AUTH_INTERNAL_TOKEN). The strict host audit refuses a placeholder and refuses
# a value equal to AUTH_INTERNAL_TOKEN. Cutover runbook:
# docs/50-deployment/15-idp-internal-token-cutover.md

IDP_INTERNAL_TOKEN=CHANGEME_RANDOM_TOKEN
