# deploy/.env
# Optional Docker Compose variable overrides. 12-generate-env-files.sh generates this file
# automatically only when it does not already exist. Do not commit real values.
#
# Infrastructure credentials live in secrets/rds-pw-* (RDS PostgreSQL service
# roles; owner URL in secrets/rds-owner.env) and secrets/tair-pw-default (Tair Redis). Service containers receive REDIS_URL from
# secrets/platform.env. Shared SMTP settings live in secrets/platform-mail.env.

# Optional image source variables. GitHub Actions injects these during automated
# production deployment. Manual deployments may uncomment and set them as needed.
# The ACR instance id is account-specific and stays out of this public repo —
# take it from the owner's record or from the running host's runtime/.env.
# VX_IMAGE_REGISTRY=<acr-instance>.cn-hangzhou.personal.cr.aliyuncs.com
# VX_IMAGE_NAMESPACE=vxture
# VX_IMAGE_TAG=latest

# Tailnet addresses of the deployment hosts, read by 30-deploy-platform-stack.sh
# and exported for compose interpolation. Set these on the host only — the whole
# point is that the addresses live outside a public repo.
# VX_WORKER01_TAILNET_IP=<worker-01-tailnet-ip>
# VX_WORKER02_TAILNET_IP=<worker-02-tailnet-ip>
