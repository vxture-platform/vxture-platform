# Workbench portal runtime. No credentials belong in this file.
# @package @vxture/repo
# @layer Infrastructure
# @category deployment
# @author AI-Generated
# @date 2026-11-05
NODE_ENV=production
PORT=3060
# Nginx routes /auth/* and /api/* to the dedicated Workbench BFF.
WORKBENCH_SAME_ORIGIN_BFF=1
WORKBENCH_SAME_ORIGIN_CATALOG=1
WORKBENCH_WEBSITE_URL=https://vxture.com
WORKBENCH_CONSOLE_URL=https://console.vxture.com
# Optional absolute path to an operator-mounted copy configuration.
WORKBENCH_HOME_COPY_FILE=
