# deploy/.env.admin-bff
# Runtime env for admin-bff. This service is an OIDC RP for the operator realm:
# operator login (and its Turnstile) run on the IdP (auth-bff); admin-bff reads
# the operator RP session and verifies no Turnstile itself.
#
# Shared platform secrets are injected by compose.platform.yml through
# secrets/platform.env. Shared mail credentials are injected through
# secrets/platform-mail.env. The IdP internal-face key (IDP_INTERNAL_TOKEN,
# what this service sends to auth-bff /internal/* for operator admin actions
# and step-up) is injected through secrets/platform-idp-internal.env — it is a
# different value from AUTH_INTERNAL_TOKEN (product face, platform-api only).
# Do not duplicate DATABASE_URL, REDIS_URL, JWT_SECRET, JWT_REFRESH_SECRET,
# AUTH_INTERNAL_TOKEN, IDP_INTERNAL_TOKEN, or SMTP_* here.

NODE_ENV=production
ADMIN_BFF_PORT=3031
DB_POOL_MAX=10

# JWT runtime options
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d
AUTH_COOKIE_DOMAIN=.vxture.com

# Internal service URLs
AUTH_BFF_URL=http://vx-platform-auth-bff:3081
# Atlas（AI 模型供给商，独立仓 vxture-atlas）部署于 worker-02，走 tailnet IP（同
# varda 部署登记已随 vxture-varda 独立仓迁出(2026-08-18)。
# docs/50-deployment/13-infra-allocation-registry.md §3 atlas 行）——admin-bff 之前
# 从未配过这个变量，落回 schema 默认 localhost:3100（指向自己），实际打不通。
ATLAS_API_URL=http://<worker-02-tailnet-ip>:3100
# Runos（能力注册表，独立仓 vxture-runos）同样部署于 worker-02，走 tailnet。admin 的
# 「技能市场」是 Runos 能力目录的**只读**视图（owner 2026-08-30 裁定：注册 / 晋升 /
# 退役留在 opera「能力注册」）。不填则 zod 默认 localhost:3120 生效——容器里没有这个
# 服务，/api/runos/* 全部 502 RUNOS_UNAVAILABLE。与 opera-bff 的同名变量取同一个值。
RUNOS_API_URL=http://<worker-02-tailnet-ip>:3120
# opera（能力控制台）的公网 origin，admin 只用它拼「去 opera 能力注册管理」这条链接
# （/api/runos/management-entry），不打它的接口。仓内按硬化口径放 x.vxture.com 占位，
# 真实主机名只在宿主机的运行时 env 里——与 .env.opera-bff 的 OPERA_BASE_URL 取同一个值。
OPERA_BASE_URL=https://x.vxture.com

# OIDC issuer = public IdP face (accounts surface). The RP builds the browser
# authorize redirect + discovery from this; MUST be the public issuer, not the
# localhost schema default. See docs/design/identity-access-topology.md.
OIDC_ISSUER=https://accounts.vxture.com

# This RP's own public origin. The RP derives its redirect_uri
# (${ADMIN_BASE_URL}/auth/callback) + allowed return origins from it; MUST be
# the public host, not the localhost schema default — otherwise the IdP
# rejects authorize with 400 invalid_redirect_uri (the registered
# redirect_uris must match exactly).
#
# HARDENING (2026-07-28, same nature as the capability console/opera): the
# real public hostname must NEVER enter the repo. This example uses the
# y.vxture.com placeholder; the production file on the host carries the real
# vhost. See deploy/nginx/templates/admin.vhost.template.
ADMIN_BASE_URL=https://y.vxture.com

# console 的公网 origin。admin-bff 也发**客户**通知（运营确认收款后的「订单已开通」、
# 退款进度等，走 commerce-services.provider 里的 NotificationDispatcher），邮件里的
# 链接要拼这个前缀。不设不报错、也不影响任何接口——只是那些邮件不带链接，客户收到后
# 得自己进 console 找单（2026-09-08 走查发现生产上一直没设）。与 .env.console-bff
# 的同名变量取同一个值；本行留注释，真实值只在宿主机的运行时 env 里。
# CONSOLE_BASE_URL=https://console.vxture.com

# Confidential RP client secret. The browser client_id is "admin"; this secret
# authenticates the RP at the IdP token endpoint. Generated + filled by
# scripts/27-provision-client-secrets.sh; the matching bcrypt hash lands in
# .env.auth-bff (OIDC_CLIENT_SECRET_HASH_ADMIN) → seed → iam.oidc_client. Empty
# here blocks deploy via strict env-audit; unfilled at runtime → RP token
# exchange fails 401 invalid_client.
OIDC_CLIENT_SECRET=

# ARDA_PROVISION_WEBHOOK_SECRET moved to .env.platform-api (product_310 D13):
# the provisioning dispatcher now runs in platform-api, not admin-bff.

# ── Ops todo escalation thresholds (same block as .env.platform-api) ──────────
# The admin todo page (GET /api/ops/todos → @vxture/service-ops-todos) computes the
# "已超时" badge from these thresholds read from THIS process env, while the alert
# job that writes the matching critical notices reads them from .env.platform-api.
# If the two differ, the page says one thing and the notices another. The twelve
# lines below MUST be line-identical in both example files —
# scripts/guardrails/check-ops-threshold-env-parity.mjs holds that; keep the host
# runtime files in step the same way. Unset = default; positive integers only.
# Anything above 20000 (in the key's own unit) is read as 20000: larger would
# overflow the int4 arithmetic in the shared SQL and take the whole todo query down.
# OPS_ESCALATE_CONFIRM_PAYMENT_HOURS=4
# OPS_ESCALATE_REFUND_AUDIT_HOURS=24
# OPS_ESCALATE_REPROVISION_MINUTES=30
# OPS_ESCALATE_VERIFICATION_DAYS=3
# OPS_ESCALATE_REFUND_EXECUTE_HOURS=24
# OPS_ESCALATE_REFUND_PROCESSING_HOURS=24
# OPS_ESCALATE_REFUND_FAILED_HOURS=4
# OPS_ESCALATE_ADDON_CONFIRM_HOURS=4
# OPS_ESCALATE_TICKET_SLA_HOURS=4
# OPS_ESCALATE_MAINTENANCE_OVERDUE_MINUTES=30
# Maturity thresholds (not escalation): under these the row is not a todo yet.
# OPS_ORDER_AGING_HOURS=24
# OPS_REFUND_STUCK_HOURS=4
