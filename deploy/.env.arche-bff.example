# deploy/.env.arche-bff
# Runtime env for arche-bff — the platform governance-plane shell BFF.
# Workforce-realm OIDC RP (client_id "arche"); highest-trust operator surface
# (identity, RBAC, audit, compliance, config). Also runs operator step-up
# (TOTP) forwarding to the IdP.
#
# Shared platform secrets (REDIS_URL, …) are injected by compose.platform.yml
# through secrets/platform.env. Do not duplicate them here.
#
# HARDENING (placeholder-only policy): the governance plane's real public
# hostname must NEVER enter the repo. This example uses the g.vxture.com
# placeholder; the production file on the host carries the real vhost.

NODE_ENV=production
ARCHE_BFF_PORT=3051

# Internal service URLs
AUTH_BFF_URL=http://vx-platform-auth-bff:3081

# OIDC issuer = public IdP face (accounts surface).
OIDC_ISSUER=https://accounts.vxture.com

# This RP's own public origin. redirect_uri = ${ARCHE_BASE_URL}/auth/callback
# must match the seeded appoidc.oidc_clients row — seed and this env must carry
# the SAME real hostname (both host-side only; repo keeps the placeholder).
ARCHE_BASE_URL=https://g.vxture.com

# Confidential RP client secret (client_id "arche"). Generated + filled by
# scripts/27-provision-client-secrets.sh; the matching bcrypt hash lands in
# .env.auth-bff (OIDC_CLIENT_SECRET_HASH_ARCHE) → seed → appoidc. Empty at
# runtime → RP token exchange fails 401 invalid_client.
# (arche-bff reads OIDC_CLIENT_SECRET_ARCHE first, then falls back to
# OIDC_CLIENT_SECRET; the provisioning script writes OIDC_CLIENT_SECRET.)
OIDC_CLIENT_SECRET=

# Operator RP session TTL (seconds). Governance is the highest-trust surface —
# keep it short. Default (unset) falls back to the RP default.
#RP_SESSION_TTL=43200
