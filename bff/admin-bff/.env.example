# ================================================================
# @vxture/bff-admin — 包级环境变量说明
# ================================================================
# 本包无独立 .env.local 需求。
# 所有共享变量（JWT、DB、Redis、SMTP、端口等）由根目录 .env.local 统一管理。
# 仅在需要覆盖根目录值时，在本包创建 .env.local 并填写以下变量。
# ================================================================

# ── 包专属端口（根目录已设置，无需重复填写）─────────────────────
# ADMIN_BFF_PORT=3043

# ── Atlas（AI 模型供给商）地址（admin 侧 AI 功能使用）──────────────
# 根目录已设置 ATLAS_API_URL=http://localhost:3100
# 仅在需要指向其他实例时覆盖
# ATLAS_API_URL=http://localhost:3100
# Optional anonymous voucher issuance; use the same dedicated key ring in console-bff.
# Values are provisioned through the secret manager. Retain old versions until their vouchers expire.
# VOUCHER_CLAIM_ACTIVE_KEY=k1
# VOUCHER_CLAIM_KEYS={"k1":"<64 random hex characters>"}

# Event synchronization: apply 2026-12-22 migration and register the exact client first.
RP_IDENTITY_RECOVERY_ENABLED=false
RP_IDENTITY_CHANGES_ENABLED=false
RP_SESSION_EVENTS_ENABLED=false
RP_SESSION_POLLING_RETIREMENT_ENABLED=false
RP_IDENTITY_ENVIRONMENT=dev
