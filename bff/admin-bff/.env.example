# ================================================================
# @vxture/bff-admin — 包级环境变量说明
# ================================================================
# 本包无独立 .env.local 需求。
# 所有共享变量（JWT、DB、Redis、SMTP、端口等）由根目录 .env.local 统一管理。
# 仅在需要覆盖根目录值时，在本包创建 .env.local 并填写以下变量。
# ================================================================

# ── 包专属端口（根目录已设置，无需重复填写）─────────────────────
# ADMIN_BFF_PORT=3043

# ── Atlas（AI 模型供给商）地址（admin 侧 AI 功能使用）──────────────
# 根目录已设置 ATLAS_API_URL=http://localhost:3100
# 仅在需要指向其他实例时覆盖
# ATLAS_API_URL=http://localhost:3100
