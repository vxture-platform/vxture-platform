# ================================================================
# @vxture/bff-console — 包级环境变量说明
# ================================================================
# 本包无独立 .env.local 需求。
# 所有共享变量（JWT、DB、Redis、SMTP、端口等）由根目录 .env.local 统一管理。
# 仅在需要覆盖根目录值时，在本包创建 .env.local 并填写以下变量。
# ================================================================

# ── 包专属端口（根目录已设置，无需重复填写）─────────────────────
# CONSOLE_BFF_PORT=3021
# Optional anonymous voucher claims; must match admin-bff's dedicated key ring.
# VOUCHER_CLAIM_ACTIVE_KEY=k1
# VOUCHER_CLAIM_KEYS={"k1":"<64 random hex characters>"}

# Enable only after the identity recovery migration and matching client scope registration.
RP_IDENTITY_RECOVERY_ENABLED=false
# Explicit deployment identity: dev / beta / prod; never inferred from release channel.
RP_IDENTITY_ENVIRONMENT=dev
# Requires durable recovery plus the RP notification migration; default off.
RP_SESSION_EVENTS_ENABLED=false
RP_IDENTITY_CHANGES_ENABLED=false

# Enable only after fact coverage, signed delivery and target proxy acceptance.
# Requires OIDC RP, identity recovery, changes and session events above.
RP_SESSION_POLLING_RETIREMENT_ENABLED=false
