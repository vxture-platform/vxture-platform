{
  "openapi": "3.1.0",
  "info": {
    "title": "Platform changes-v1 signed identity receiver",
    "version": "0.7.0-local",
    "description": "Local opt-in realm-isolated platform-BFF profile; not deployed. Each signed event invalidates authority and never grants access. Standard OIDC logout remains a separate protocol. Workforce requires WORKFORCE_IDENTITY_SYNC_ENABLED. Realms never share subjects, cursors, receipts or versions."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/auth/identity-events": {
      "post": {
        "operationId": "receiveIdentityChange",
        "summary": "Persist a verified identity invalidation before acknowledgment",
        "description": "Requires RP_IDENTITY_CHANGES_ENABLED, RP_IDENTITY_RECOVERY_ENABLED and RP_SESSION_EVENTS_ENABLED. Authentication uses the typed RS256 JWS body and the configured issuer JWKS, not cookies. Exact issuer, audience, configured customer/workforce realm and environment binding. Maximum 64 KiB. iat and exp must be integer seconds, exp > iat, exp - iat <= 120; 60 second clock tolerance. Verification precedes inbox deduplication. Logical fact equality excludes the opaque cursor, which recovery may refresh. Higher subject versions invalidate all authorization scopes; old versions cannot replace newer barriers. No central snapshot call occurs in the receiver ACK path. Workforce permits access invalidations only, with opr_ subjects and null organization/workspace/product scope.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/jwt": {
              "schema": {
                "type": "string",
                "maxLength": 65536,
                "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
              },
              "x-decoded-payload": {
                "$ref": "#/components/schemas/Envelope"
              },
              "x-protected-header": {
                "$ref": "#/components/schemas/ProtectedHeader"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Inbox and monotonic invalidation committed, including an identical duplicate. Empty body."
          },
          "400": {
            "description": "Request rejected; no acknowledgment.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["code"],
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Invalid signature, type, event shape, binding or lifetime. Sender quarantines and suspends this receiver.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["code"],
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Capability disabled; empty body."
          },
          "409": {
            "description": "Same logical event ID has conflicting fact content; original durable state preserved.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["code"],
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 64 KiB."
          },
          "503": {
            "description": "JWKS or durable persistence unavailable; sender must retry.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["code"],
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
