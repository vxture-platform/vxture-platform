# Additional project-specific ignores (added by analysis)
# These are local/runtime or editor files that should not be committed.
# Remove from tracked files with: git rm --cached <path>

# PID / runtime files
*.pid
.vxture_frontend.pid

# Local virtual environments (ensure any venvs under packages are ignored)
**/.venv/
**/venv/

