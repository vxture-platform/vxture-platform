# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Package manager lock files (keep pnpm-lock.yaml)
package-lock.json
yarn.lock

# Testing
coverage/
.nyc_output/
*.lcov

# Prisma generated clients (regenerated by prisma generate in CI).
# 只忽略 prisma 子目录：早先的 `**/src/generated/` 把 design-tokens 的生成物一起
# 吞了，那份是**提交进仓**的（`generate-token-ts.mjs --check` 守它与策略源同步），
# CI 里没有任何步骤会重新生成它，于是 type-check 找不到模块。
**/src/generated/prisma/

# Build outputs
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/

# Environment variables — deny-by-default: every .env* at any level is ignored
# except *.example templates (real values live in runtime/ locally or
# /srv/vxture/runtime on hosts).
.env
.env.*
.env*.local
!.env.example
!.env.*.example
# Deploy bundle must keep templates only; real runtime secrets belong to runtime/ or /srv/vxture/runtime.
deploy/**/.env
deploy/**/.env.*
!deploy/**/.env.example
!deploy/**/.env.*.example
# Deploy secrets dirs: deny-by-default (filename enumeration left platform-app/
# platform-identity/platform-sms/varda-pg-password committable — 2026-07-21 audit).
deploy/**/secrets/*
!deploy/**/secrets/*.example
!deploy/**/secrets/.gitkeep

# Local runtime env/secrets. These files are real secrets and must not be committed.
runtime/.env
runtime/.env.*
runtime/secrets/
runtime/local/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and editor files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/settings.json.template
!.vscode/*.template
# SonarLint 的本地分析缓存与连接配置，逐人逐机不同，且可能带上绑定的 token。
.sonarlint/

# Logs
logs/
# Source route directories named "logs" are code, not runtime output
# (the bare logs/ rule silently dropped opera's observability/logs page).
!portals/*/src/**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

