# =============================================================================
# Vxture environment template
# Copy this file to .env.local and fill real values before local startup.
# .env.local is ignored by git and must never be committed.
#
# Scope: root-level local startup for BFF services, agent servers, and AI gateway.
# dev-panel injects the root .env.local into local services. If a Next.js portal
# is started directly from its own directory, make sure NEXT_PUBLIC_* values are
# also available in that shell or the portal-specific .env.local.
# =============================================================================

# Runtime
NODE_ENV=development

# Database - PostgreSQL
DATABASE_URL=postgresql://vxture:localdev@localhost:5433/platform_main
DB_HOST=localhost
DB_PORT=5433
DB_USER=vxture
DB_PASSWORD=localdev
DB_NAME=platform_main
DB_POOL_MAX=10

# Cache - Redis
REDIS_URL=redis://localhost:6379

# Auth / JWT
# Production values must be at least 32 random characters.
JWT_SECRET=CHANGE_ME_JWT_SECRET_32_CHARS_MIN
# Refresh tokens must use a separate secret from JWT_SECRET.
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_32_CHARS_MIN
JWT_ACCESS_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d
# Leave empty for local development. Use .vxture.com in production for shared
# cookies across platform subdomains.
AUTH_COOKIE_DOMAIN=

# auth-bff's central session cookie Secure flag; `pnpm dev:panel` auto-injects
# this. Never set in production.
# IDP_COOKIE_INSECURE=true

# Operator TOTP secret-at-rest key (≥32 chars). Required for operator MFA
# enroll/verify; unset fails closed (503). Generate a throwaway local value,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
OPERATOR_TOTP_ENC_KEY=CHANGE_ME_OPERATOR_TOTP_ENC_KEY_32_CHARS_MIN

# Skip operator MFA entirely for local login testing. Fails closed in
# production regardless of this value.
# OPERATOR_MFA_DEV_BYPASS=true

# IdP signing key (auth-bff OIDC issuance)
# auth-bff signs RS256 tokens with this key; when unset the IdP fails closed
# ("IdP issuance disabled") and login flows that need token issuance will not
# work locally. Generate a throwaway local keypair, e.g.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# and paste the PEM (single-line base64 of the PEM is also accepted).
# Production never uses these values from here: worker hosts provision them
# via deploy/secrets/platform-identity.env (25-provision-signing-key.sh).
OIDC_ACTIVE_KID=CHANGE_ME_OIDC_KID
OIDC_SIGNING_PRIVATE_KEY=CHANGE_ME_OIDC_SIGNING_PRIVATE_KEY_PEM

# Portal base URLs
WEBSITE_BASE_URL=http://localhost:3000
CONSOLE_BASE_URL=http://localhost:3020

# Service ports
GATEWAY_PORT=8000
AUTH_BFF_PORT=3081
WEBSITE_BFF_PORT=3001
CONSOLE_BFF_PORT=3021
ADMIN_BFF_PORT=3031
VARDA_BFF_PORT=3090
VARDA_SERVER_PORT=3091
MODEL_PLATFORM_PORT=3100

# Internal service URLs
ATLAS_API_URL=http://localhost:3100
RUNOS_API_URL=http://localhost:3120
VARDA_SERVER_INTERNAL_URL=http://localhost:3091
# Target auth-bff URL used by website-bff, console-bff, and admin-bff.
AUTH_BFF_URL=http://localhost:3081
# Gateway upstream origins used by gateway-bff in local development.
WEBSITE_BFF_ORIGIN=http://localhost:3001
CONSOLE_BFF_ORIGIN=http://localhost:3021
ADMIN_BFF_ORIGIN=http://localhost:3031
AUTH_BFF_ORIGIN=http://localhost:3081
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3020,http://localhost:3030,http://localhost:3040
# Shared internal service token. Production must set the same value in auth-bff
# and every BFF that calls auth-bff internal endpoints.
AUTH_INTERNAL_TOKEN=CHANGE_ME_AUTH_INTERNAL_TOKEN
# OIDC RP client secret for local development only. In production each BFF gets
# its own value from its own deploy/.env.<service> file, because admin, console,
# opera and website are four separate OIDC clients with four separate secrets.
# Locally there is no such separation: all four read process.env.OIDC_CLIENT_SECRET
# and dev-panel injects this file into every child process, so whatever is set
# here goes to all four and only the client it actually belongs to can complete a
# token exchange — the others get invalid_client. Same shape as the
# LOCAL_BFF_PROXY_URL trap documented in tools/dev-panel/src/services.mjs; the fix
# is per-service names injected from services.mjs, not a value change here.
OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_CLIENT_SECRET
# Admin portal base URL used by auth-bff OAuth allowlist handling.
ADMIN_BASE_URL=http://localhost:3030
# Same value, NEXT_PUBLIC_ so opera's browser bundle can build a plain jump link
# to admin's commercial pages (product 发布管理阶段四：grants 等商业授权页仍在
# admin，opera 只出跳转入口，不重建）。
NEXT_PUBLIC_ADMIN_URL=http://localhost:3030
# arche 治理平面 base URL：opera 的 RBAC 跳转（角色/权限策略）三平面拆分后改指
# arche（2026-09-02 cutover）。生产用真名（g.vxture.com 是占位，真名走 worker-01
# runtime env 注入，不入仓）；dev 指 arche 本地端口 3050。
NEXT_PUBLIC_ARCHE_URL=http://localhost:3050
# accounts 门户 base URL：三门户（admin/opera/arche）用户弹出面板「个人信息」跳转到
# 身份层账户中心 /account（Phase B 收敛）。accounts 是公开登录门户（生产
# accounts.vxture.com，代码 prod 默认即用它，非内部主机不需占位）；dev 指本地 3080。
NEXT_PUBLIC_ACCOUNTS_URL=http://localhost:3080

# Email - Aliyun DirectMail SMTP
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@mail.example.com
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM="Vxture Studio <no-reply@mail.example.com>"

# SMS - Aliyun SMS
ALIYUN_SMS_ACCESS_KEY_ID=CHANGE_ME_ALIYUN_SMS_ACCESS_KEY_ID
ALIYUN_SMS_ACCESS_KEY_SECRET=CHANGE_ME_ALIYUN_SMS_ACCESS_KEY_SECRET
ALIYUN_SMS_SIGN_NAME=CHANGE_ME_ALIYUN_SMS_SIGN_NAME
ALIYUN_SMS_TEMPLATE_CODE=SMS_000000000

# OAuth - DingTalk tenant login
DINGTALK_APP_KEY=CHANGE_ME_DINGTALK_APP_KEY
DINGTALK_APP_SECRET=CHANGE_ME_DINGTALK_APP_SECRET
# Must exactly match the OAuth callback URL configured in DingTalk Open Platform.
# Local: http://localhost:8000/auth-api/auth/oauth/dingtalk/callback
# Production: https://api.vxture.com/auth-api/auth/oauth/dingtalk/callback
DINGTALK_REDIRECT_URI=http://localhost:8000/auth-api/auth/oauth/dingtalk/callback

# OAuth - Feishu tenant login
FEISHU_APP_ID=CHANGE_ME_FEISHU_APP_ID
FEISHU_APP_SECRET=CHANGE_ME_FEISHU_APP_SECRET
FEISHU_REDIRECT_URI=http://localhost:8000/auth-api/auth/oauth/feishu/callback

# AI model - ByteDance Ark / Doubao
DOUBAO_API_KEY=CHANGE_ME_DOUBAO_API_KEY

# Varda agent
VARDA_DEFAULT_MODEL_CODE=doubao-seed-2-0-lite-260215
# Platform tenant UUID used for admin-surface LLM billing attribution.
VARDA_PLATFORM_LLM_TENANT_ID=CHANGE_ME_PLATFORM_TENANT_UUID
# Optional Model Platform agent UUID. Leave empty to meter by tenantId.
# VARDA_LLM_AGENT_ID=

# Cloudflare Turnstile
# When CF_TURNSTILE_ENABLED=true, the server enforces Turnstile verification
# (auth-bff). Dev recipe (2026-08-29): use Cloudflare's documented dummy keys so
# both the pass path AND the failure/replay paths are reproducible locally -
# a real widget cannot be made to fail on demand.
#   site keys (accounts, baked at build):  1x00000000000000000000AA  always passes (visible)
#                                          2x00000000000000000000AB  always fails  (visible)
#                                          3x00000000000000000000FF  forces interactive challenge
#   secret keys (auth-bff):                1x0000000000000000000000000000000AA  always passes
#                                          2x0000000000000000000000000000000AA  always fails
#                                          3x0000000000000000000000000000000AA  "token already spent"
# A dummy secret answers hostname=example.com with no action, so the verifier
# only accepts it when CF_TURNSTILE_ALLOW_TESTING_KEYS=true. Hostnames still
# must be non-empty (the verifier refuses an empty list before it ever calls
# Cloudflare). Production refuses ALLOW_TESTING_KEYS=true via the env audit.
CF_TURNSTILE_ENABLED=true
CF_TURNSTILE_ALLOW_TESTING_KEYS=true
NEXT_PUBLIC_CF_TURNSTILE_TENANT_SITE_KEY=1x00000000000000000000AA
CF_TURNSTILE_TENANT_SECRET_KEY=1x0000000000000000000000000000000AA
CF_TURNSTILE_TENANT_ALLOWED_HOSTNAMES=localhost,127.0.0.1
NEXT_PUBLIC_CF_TURNSTILE_ADMIN_SITE_ID=1x00000000000000000000AA
CF_TURNSTILE_ADMIN_SECRET_KEY=1x0000000000000000000000000000000AA
CF_TURNSTILE_ADMIN_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# Optional AI providers
# OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY
# QWEN_API_KEY=your-qwen-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key

# Optional monitoring / analytics
# SENTRY_DSN=https://...@sentry.io/...
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://app.posthog.com

# Local confidential-client secrets — generated by `pnpm db:local:secrets`, never
# committed with values. Per client rather than one shared OIDC_CLIENT_SECRET
# above: the four portals are four separate OIDC clients, so a single shared
# value lets exactly one of them complete token exchange and the other three
# fail with invalid_client — visible only as "login never comes back" on
# whichever portal you opened. The HASH_* half is what the seed projects into
# appoidc.oidc_clients; the plaintext half is what the RP presents.
OIDC_CLIENT_SECRET_HASH_WEBSITE=
OIDC_CLIENT_SECRET_WEBSITE=
OIDC_CLIENT_SECRET_HASH_CONSOLE=
OIDC_CLIENT_SECRET_CONSOLE=
OIDC_CLIENT_SECRET_HASH_ADMIN=
OIDC_CLIENT_SECRET_ADMIN=
OIDC_CLIENT_SECRET_HASH_OPERA=
OIDC_CLIENT_SECRET_OPERA=
OIDC_CLIENT_SECRET_HASH_UMBRA=
OIDC_CLIENT_SECRET_UMBRA=
